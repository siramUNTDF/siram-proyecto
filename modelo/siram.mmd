    %% SIRAM — modelo de datos canónico (fuente de verdad del dominio)
    %% Versión 2 · BORRADOR 2026-11-02 (revisado 2026-11-03) · sin tag: todavía no es contrato con el back.
    %%   Vuelca lo decidido del 2026-10-23 al 2026-10-30 (decisiones.md) y la demo de Figma (diseno/figma/demo.md).
    %%   «TENTATIVO» = propuesta en revisión que se modela igual (CONTEXTO §9, criterio para lo tentativo).
    %%   «SUPUESTO» = lo agregó el agente de diseño para cerrar un hueco; lo tiene que revisar el equipo.
    %% Versión 1 · 2026-10-08 · nunca publicada, superada (ver git y decisiones.md).
    %% Versión 0 · 2026-10-08 · tag modelo-v0.
    %% ---
    %% Convenciones para todas las entidades (no se repiten en cada una):
    %%   · id: clave sustituta.
    %%   · creado_en y modificado_en: automáticos, salvo en las tablas de historial (RN-27).
    %%   · No hay borrado físico (RN-06b): bajas por estado o por marca.
    %%   · Historial (RN-27): cada entidad salvo SOLICITUD tiene su tabla espejo <ENTIDAD>_HISTORICO, al final
    %%     del archivo (patrón django-simple-history). Cada fila es la foto completa del registro más los
    %%     campos hist_*: operación, fecha y hora, usuario (nulo = Sistema), organismo del usuario en ese
    %%     momento y caso de contexto opcional. El prefijo evita choques con campos copiados (p. ej. USUARIO.organismo_id). Las FK copiadas no llevan restricción: apuntan a lo que había en ese momento.
    %%     No llevan creado_en ni modificado_en: una fila de historial nunca se edita.
    %%     Las relaciones de los campos hist_* no se dibujan para no ensuciar el diagrama.
    %%   · Enumerados con «no_sabe»: la persona respondió que no sabe. Nulo = sin dato (RN-23).

    ORGANISMO ||--o{ USUARIO : agrupa
    USUARIO ||--o{ CASO : registra
    USUARIO ||--o{ SOLICITUD : resuelve
    USUARIO ||--o{ DENUNCIA : anota
    USUARIO ||--o{ TRATAMIENTO : carga

    PERSONA ||--o{ CASO : "es víctima en"
    PERSONA |o--o{ CASO : "es contacto responsable en"
    TIPO_EVENTO |o--o{ CASO : clasifica
    CIUDAD |o--o{ CASO : ubica
    CASO |o--o{ CASO : "unificado en"

    CASO |o--o{ SOLICITUD : "procede de"
    SOLICITUD |o--o{ DOCUMENTO : "fotos enviadas"

    CASO ||--|{ CASO_ANIMAL : involucra
    ANIMAL ||--o{ CASO_ANIMAL : "aparece en"
    ANIMAL |o--o{ ANIMAL : "absorbido por"
    PERSONA |o--o{ CASO_ANIMAL : "es dueño en"
    CASO_ANIMAL ||--o| DESCRIPCION : "se describe"
    CASO_ANIMAL |o--o{ DOCUMENTO : "fotos del animal"

    CASO ||--o| TRATAMIENTO : "atención de Salud"
    CASO ||--o{ DENUNCIA : "tiene anotada"
    CASO |o--o{ DOCUMENTO : adjunta
    CASO ||--o{ COINCIDENCIA : "caso A"
    CASO ||--o{ COINCIDENCIA : "caso B"


    ORGANISMO {
        id id PK
        string nombre
        enum tipo "salud|zoonosis|cadic (define los permisos de dominio, RN-35)"
        bool activo
    }
    USUARIO {
        id id PK
        id organismo_id FK "SUPUESTO: nulo para administrador y analista"
        string nombre
        string correo UK "usuario de acceso"
        string password_hash "fuera del historial"
        enum rol "administrador|agente|analista"
        bool activo "no se borra: se desactiva (RN-27)"
    }
    CIUDAD {
        id id PK
        string nombre UK "Ushuaia, Río Grande, Tolhuin"
        bool activo
    }
    TIPO_EVENTO {
        id id PK
        string nombre UK "TENTATIVO: ataque con mordedura|lesión compatible|intento sin lesión|lesión derivada"
        string descripcion
        bool activo
    }
    PERSONA {
        id id PK
        string dni UK "obligatorio salvo canal histórico (RN-21); validación de formato"
        string nombre "SUPUESTO: nombre y apellido separados, como el formulario inicial"
        string apellido
        string telefono "P4"
        string correo "P3"
        string domicilio "P7"
    }
    CASO {
        id id PK
        string numero UK "C-AAAA-NNNN, visible"
        enum canal_origen "ciudadano|salud|zoonosis|cadic|historico (RN-30)"
        enum estado "registrado|en_seguimiento|finalizado|desestimado|unificado; transiciones en RN-36 (grave es marca derivada, 2026-11-03)"
        enum motivo_espera "contacto|respuesta|certificado; solo si en_seguimiento"
        enum motivo_desestimacion "TENTATIVO: fuera_de_alcance|fuera_de_provincia|inexistente_o_no_verificable|cargado_por_error; obligatorio si desestimado"
        string observacion_desestimacion
        id unificado_en_caso_id FK "solo si unificado"
        id victima_persona_id FK "obligatoria, una por caso (RN-20)"
        id contacto_persona_id FK "opcional"
        int victima_edad "P2, en años, al momento del hecho (en CASO, no en PERSONA: decisión 2026-11-02)"
        id tipo_evento_id FK "T1"
        date fecha_hecho "H1; Salud puede no tenerla (RN-30)"
        time hora_hecho "H2"
        id ciudad_id FK "H3; sin opción «Otra» (2026-11-03)"
        decimal latitud "RN-33, sin PostGIS"
        decimal longitud
        string direccion "H4"
        string referencias
        enum tipo_lugar "H5: casa_propia|casa_ajena|via_publica|espacio_publico|zona_rural|no_sabe"
        enum hizo_denuncia "D1 declarado: si|no; nulo = sin dato. Solo desde la solicitud (RN-07)"
        enum motivo_no_denuncia "D3: animal_propio_o_conocido|no_sabia_donde|no_sabia_que_habia_que|no_le_tomaron|economicas|no_pasa_nada|otros"
        id registrado_por_usuario_id FK
    }
    SOLICITUD {
        id id PK
        string numero UK "S-AAAA-NNNN, visible para la persona"
        enum estado "pendiente|descartada|registrada (RN-31)"
        id caso_id FK "registrada <=> tiene caso"
        bool es_victima "¿Sos quien sufrió el ataque?"
        string informante_nombre
        string informante_apellido
        string informante_dni
        string informante_telefono
        string informante_correo
        string victima_nombre "nulo si es_victima"
        string victima_apellido
        string victima_dni
        date fecha_hecho
        enum especie "perro|gato (del primer animal)"
        json detalle "formulario detallado tal cual, por sección (RN-32). SUPUESTO: JSON, no columnas"
        int secciones_completas "0 a 4"
        string token_hash "token del detallado; nunca el número (RN-32)"
        datetime token_vence_en "aprox. 1 h"
        datetime resuelta_en
        id resuelta_por_usuario_id FK
        string motivo_descarte "SUPUESTO: texto libre opcional"
        bool eliminada "borrado lógico (RN-06b)"
    }
    ANIMAL {
        id id PK
        enum especie "perro|gato"
        string chip UK "opcional"
        bool vigente "falso si fue absorbido"
        id absorbido_por_animal_id FK "RN-22, reconciliación manual"
    }
    CASO_ANIMAL {
        id id PK
        id caso_id FK
        id animal_id FK "único junto con caso_id"
        int orden "Animal 1 de N"
        id dueno_persona_id FK "dueño durante el caso; carga Zoonosis"
        enum tenencia "A5: propio|ajeno_conocido|ajeno_desconocido|no_sabe"
        string domicilio_animal "A7"
        enum vacunado "A8: si|no|no_sabe"
        enum puede_reconocerlo "A11: si|no|no_sabe"
        enum observacion_dia10 "TENTATIVO: pendiente|sin_novedad|murio_o_enfermo|ubicado_sin_acceso|no_ubicado; murio_o_enfermo = marca Grave del caso"
        date observacion_dia10_fecha
        string observaciones "seguimiento de Zoonosis"
    }
    DESCRIPCION {
        id caso_animal_id PK "1:1 con CASO_ANIMAL"
        enum tamano "A2: chico|mediano|grande|no_sabe"
        enum sexo "A9: macho|hembra|no_sabe"
        enum edad_aparente "cachorro|adulto|viejo|no_sabe"
        string color "A13"
        enum conoce_raza "A3: si|no"
        string raza "A4"
    }
    TRATAMIENTO {
        id id PK
        id caso_id FK "único: un tratamiento por caso (RN-34)"
        date fecha_consulta
        enum zona_cuerpo "L3: piernas|manos|brazos|cara|tronco|multiples (multiples TENTATIVO, §7.7)"
        enum gravedad "L2: excoriacion|herida_superficial|herida_profunda|amputacion"
        bool vacuna_antirrabica "L7, TENTATIVO sí/no (esquema a consultar con Salud)"
        bool antitetanica
        bool antibiotico "L6"
        bool sutura "L5"
        string observaciones
        id cargado_por_usuario_id FK
    }
    DENUNCIA {
        id id PK
        id caso_id FK "obligatorio: nunca existe sola (RN-06)"
        string dni_denunciante "obligatorio; sin enlace a PERSONA"
        date fecha "H0, obligatoria"
        string numero_tramite "opcional, sin formato"
        enum estado "TENTATIVO: pendiente_confirmacion|confirmada|desestimada (HZ08, RN-13 en revisión)"
        string observaciones
        id anotada_por_usuario_id FK "solo Zoonosis"
    }
    DOCUMENTO {
        id id PK
        id caso_id FK "certificado médico (X1)"
        id caso_animal_id FK "fotos del animal (X2)"
        id solicitud_id FK "SUPUESTO: fotos enviadas por la persona; exactamente una de las tres FK"
        string nombre_archivo
        string url
    }
    COINCIDENCIA {
        id id PK
        id caso_a_id FK "el caso que ya existía"
        id caso_b_id FK "el caso nuevo; misma víctima (mismo DNI) que caso_a"
        enum desenlace "consolidado|distintos; nulo = pendiente (marca Posible duplicado)"
        string observacion "aclaración del agente"
        id resuelta_por_usuario_id FK
        datetime resuelta_en
    }

    %% --- Historial: tablas espejo (RN-27) ---
